# ==============================================================================
# MirageMesh - Environment Configuration Template
# All secrets and external endpoints must be supplied via environment variables.
# ==============================================================================

# Server Runtime Configuration
# Render automatically injects PORT (e.g. 10000). Defaults to 4000 locally.
PORT=4000
NODE_ENV=development

# Allowed CORS Origins (comma-separated, no wildcards in production)
# Render services automatically allow same-origin, localhost, and *.onrender.com.
# Add your custom domain here if using a custom hostname.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Frontend Vite API Base URL
# Leave EMPTY for unified full-stack deployments on Render (relative same-origin requests).
# Only set if hosting the frontend on a separate domain from the backend API.
VITE_API_BASE_URL=
