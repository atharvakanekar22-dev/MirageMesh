{
  "name": "miragemesh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "build:client": "tsc -b && vite build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:client && npm run build:server",
    "render-build": "npm install --include=dev && npm run build",
    "start": "node server/dist/index.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "npm --prefix server install --include=dev",
    "server:install": "npm --prefix server install --include=dev",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server test",
    "test:prod": "node test-production-fullstack.mjs",
    "test:refinements": "node test-refinement-suite.mjs",
    "test": "npm run server:test && npm run test:prod && npm run test:refinements"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
