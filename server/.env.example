# ==============================================================================
# MirageMesh Server - Environment Configuration Template
# ==============================================================================

# Port is automatically assigned by Render ($PORT). Defaults to 4000 locally.
PORT=4000
NODE_ENV=development
# Allowed origins (Render automatically permits same-origin, localhost, and *.onrender.com)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
